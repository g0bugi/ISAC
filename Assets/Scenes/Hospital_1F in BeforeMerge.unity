  fadeManager: {fileID: 1004890018}
  dialogueManager: {fileID: 902074768}
  dialogueLines:
  - characterName: "\uAC04\uD638\uC0AC"
    dialogueText: " \uC598! \uC548\uADF8\uB798\uB3C4 \uCC3E\uACE0\uC788\uC5C8\uC5B4.
      \uC5B4\uB514\uAC14\uC5C8\uB2C8??"
    triggerNpcMovement: 0
    targetMovePosition: {x: 0, y: 0, z: 0}
    moveSpeed: 3
    returnAfterMovement: 0
    TalkEnd: 0
    PassThis: 0
    freezeNpcOnTalk: 0
  - characterName: "\uB098"
    dialogueText: "\uC544\uBB34\uAC83\uB3C4 \uC548\uBCF4\uC774\uACE0 \uC5EC\uAE30\uC11C
      \uB098\uAC00\uACE0\uC2F6\uC5B4\uC694!!"
    triggerNpcMovement: 0
    targetMovePosition: {x: 0, y: 0, z: 0}
    moveSpeed: 3
    returnAfterMovement: 0
    TalkEnd: 0
    PassThis: 0
    freezeNpcOnTalk: 0
  - characterName: "\uAC04\uD638\uC0AC"
    dialogueText: "\uC544\uC9C1 \uC544\uD508\uB370 \uD568\uBD80\uB85C \uB098\uAC00\uBA74
      \uC704\uD5D8\uD574"
    triggerNpcMovement: 0
    targetMovePosition: {x: 0, y: 0, z: 0}
    moveSpeed: 3
    returnAfterMovement: 0
    TalkEnd: 0
    PassThis: 0
    freezeNpcOnTalk: 0
  - characterName: "\uAC04\uD638\uC0AC"
    dialogueText: "3\uCE35 \uC785\uC6D0\uC2E4\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uB294\uAC74
      \uC5B4\uB54C? \uC5B4\uBA38\uB2C8\uAED8 \uB9D0\uC500 \uB4DC\uB9AC\uACE0\uC62C\uD14C\uB2C8
      \uC7A0\uC2DC\uB9CC \uAE30\uB2E4\uB9AC\uB834"
    triggerNpcMovement: 1
    targetMovePosition: {x: -1.39, y: 0.0000001192093, z: -8.57}
    moveSpeed: 1.5
    returnAfterMovement: 1
    TalkEnd: 0
    PassThis: 0
    freezeNpcOnTalk: 0
  - characterName: "\uAC04\uD638\uC0AC"
    dialogueText: "\uC5B4\uBA38\uB2C8\uAED8 \uC598\uAE30\uB4DC\uB838\uC5B4. \uC785\uC6D0\uC2E4\uC740
      \uC774\uCABD\uC774\uC57C"
    triggerNpcMovement: 0
    targetMovePosition: {x: 0, y: 0, z: 0}
    moveSpeed: 3
    returnAfterMovement: 0
    TalkEnd: 1
    PassThis: 0
    freezeNpcOnTalk: 0
